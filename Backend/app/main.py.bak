"""Facial Biometric PoC — Zero-Trust FastAPI Application.

Security schemes are wired natively into FastAPI so Swagger UI auto-generates
the Authorize modal with all 5 schemes. Public endpoints are explicitly exempt.
"""

from contextlib import asynccontextmanager
from datetime import UTC, datetime
from typing import Any

from fastapi import (
    FastAPI,
    HTTPException,
    Request,
    Response,
    Security,
)
from fastapi.middleware.cors import CORSMiddleware
from fastapi.openapi.utils import get_openapi
from fastapi.security import APIKeyHeader, HTTPBearer
from starlette.middleware.base import BaseHTTPMiddleware

from Backend.app.config import get_settings
from Backend.app.middleware.zero_trust import ZeroTrustMiddleware
from Backend.app.routers import (
    auth,
    health,
    iccid,
    notifications,
    selfies,
    sim_swap,
    validation,
    verification,
    verifications,
)

# ── Security scheme definitions (appear in Swagger Authorize modal) ──────────

bearer_auth = HTTPBearer(
    scheme_name="bearerAuth",
    description=(
        "RS256-signed JWT. Required claims: sub, iss, aud, exp, iat, jti, "
        "scope, geo_fence, device_binding. Max TTL: 1 hour. "
        "No refresh tokens for biometric sessions."
    ),
    auto_error=False,
)

api_key_header = APIKeyHeader(
    name="X-API-Key",
    scheme_name="apiKey",
    description=(
        "Service-to-service API key for Tier-1 mutations. "
        "Rotated weekly via Azure Key Vault. "
        "Format: sbx|prd-ak-{date}-{uuid}."
    ),
    auto_error=False,
)

nonce_header = APIKeyHeader(
    name="X-Request-Nonce",
    scheme_name="nonce",
    description=(
        "Cryptographic nonce (UUIDv4) for replay attack prevention. "
        "Must be unique within 24h window. Idempotency key for POST/PUT/PATCH."
    ),
    auto_error=False,
)

correlation_header = APIKeyHeader(
    name="X-Correlation-Id",
    scheme_name="correlationId",
    description=(
        "Trace ID for distributed logging. Required for all requests. "
        "Format: {service}-{uuid}-{timestamp}"
    ),
    auto_error=False,
)

# ── Environment & docs protection ────────────────────────────────────────────

security_settings = get_settings()

# FIX: neither `security_settings.ENV` nor `security_settings.env` exists on
# the real Settings object (confirmed by two consecutive AttributeErrors) -
# so this was never a casing issue, the field may not be defined on Settings
# at all. Rather than guess a third name, this checks every plausible spelling
# and falls back to "development" rather than crashing. Once config.py is
# shared in full, replace this with a single direct attribute access (and add
# the missing field to Settings if it's genuinely absent).
ENV = (
        getattr(security_settings, "env", None)
        or getattr(security_settings, "ENV", None)
        or getattr(security_settings, "environment", None)
        or "development"
)
IS_PROD = ENV == "production"

# Disable docs in production; gate with admin key in sandbox
docs_url = None if IS_PROD else "/docs"
redoc_url = None if IS_PROD else "/redoc"
openapi_url = None if IS_PROD else "/openapi.json"

# ── Lifespan (startup / shutdown) ────────────────────────────────────────────

@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan events."""
    # Startup: validate critical env vars
    if not security_settings.jwt_public_key and not security_settings.jwt_private_key:
        import warnings
        warnings.warn(
            "JWT keys not configured. Run: python scripts/generate_keys.py",
            stacklevel=2,
        )
    yield
    # Shutdown: cleanup if needed

# ── FastAPI app with native security wiring ──────────────────────────────────

app = FastAPI(
    title="Facial Biometric API",
    version="1.0.0",
    description=(
        "Zero-trust biometric verification platform for SIM swap, RICA, "
        "and identity validation. POPIA compliant. "
        "Data classification: SPECIAL_PERSONAL_INFORMATION."
    ),
    docs_url=docs_url,
    redoc_url=redoc_url,
    openapi_url=openapi_url,
    lifespan=lifespan,
    # Global security: every endpoint requires these by default
    dependencies=[
        Security(bearer_auth),
        Security(correlation_header),
    ],
)

# ── CORS (lock down in production) ───────────────────────────────────────────

allowed_origins = (
    ["https://facialbiometric.mtn.co.za", "https://api-sandbox.facialbiometric.mtn.co.za"]
    if IS_PROD
    else ["*"]
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=allowed_origins,
    allow_credentials=True,
    allow_methods=["GET", "POST", "PUT", "DELETE", "PATCH"],
    allow_headers=[
        "*",
        "Authorization",
        "X-API-Key",
        "X-Geo-Fence",
        "X-Device-Fingerprint",
        "X-Request-Nonce",
        "X-Correlation-Id",
    ],
)

# ── Zero-trust middleware stack ──────────────────────────────────────────────

app.add_middleware(ZeroTrustMiddleware)

# ── Admin docs gate (sandbox only) ───────────────────────────────────────────

class AdminDocsMiddleware(BaseHTTPMiddleware):
    """Gate /docs and /openapi.json behind admin API key in sandbox."""

    async def dispatch(self, request: Request, call_next):
        path = request.url.path
        if path in ("/docs", "/redoc", "/openapi.json") and not IS_PROD:
            admin_key = request.headers.get("X-Admin-Key")
            expected = (
                    getattr(security_settings, "admin_api_key", None)
                    or getattr(security_settings, "ADMIN_API_KEY", None)
            )
            if expected and admin_key != expected:
                return Response("Admin API key required", status_code=401)
        return await call_next(request)

app.add_middleware(AdminDocsMiddleware)

# ── Custom OpenAPI generator (SecurityError schema + rate-limit headers) ─────

def custom_openapi() -> dict[str, Any]:
    """Generate OpenAPI schema with zero-trust security hardening."""
    if app.openapi_schema:
        return app.openapi_schema

    openapi_schema = get_openapi(
        title=app.title,
        version=app.version,
        description=app.description,
        routes=app.routes,
    )

    components = openapi_schema.setdefault("components", {})
    schemas = components.setdefault("schemas", {})
    security_schemes = components.setdefault("securitySchemes", {})

    # 1. Register all 5 security schemes explicitly
    security_schemes.update({
        "bearerAuth": {
            "type": "http",
            "scheme": "bearer",
            "bearerFormat": "JWT",
            "description": bearer_auth.model.description,
        },
        "apiKey": {
            "type": "apiKey",
            "in": "header",
            "name": "X-API-Key",
            "description": api_key_header.model.description,
        },
        "nonce": {
            "type": "apiKey",
            "in": "header",
            "name": "X-Request-Nonce",
            "description": nonce_header.model.description,
        },
        "correlationId": {
            "type": "apiKey",
            "in": "header",
            "name": "X-Correlation-Id",
            "description": correlation_header.model.description,
        },
        "mtls": {
            "type": "mutualTLS",
            "description": (
                "X.509 client certificate authentication for intra-cluster mesh. "
                "Certificate must include SAN matching service identity. "
                "CRL checked per request."
            ),
        },
    })

    # 2. Add SecurityError schema
    schemas["SecurityError"] = {
        "type": "object",
        "properties": {
            "error": {"type": "string", "example": "Unauthorized"},
            "message": {"type": "string", "example": "Bearer token required"},
            "code": {
                "type": "string",
                "enum": [
                    "MISSING_BEARER_TOKEN",
                    "TOKEN_EXPIRED",
                    "INVALID_TOKEN",
                    "INSUFFICIENT_SCOPE",
                    "GEO_FENCE_MISMATCH",
                    "MISSING_API_KEY",
                    "DUPLICATE_NONCE",
                    "RATE_LIMIT_EXCEEDED",
                ],
            },
            "correlation_id": {"type": "string", "format": "uuid"},
            "timestamp": {"type": "string", "format": "date-time"},
            "retry_after": {"type": "integer", "nullable": True},
        },
        "required": ["error", "message", "code", "correlation_id", "timestamp"],
    }

    # 3. Add POPIA-compliant response schemas
    schemas["SelfieResponse"] = {
        "type": "object",
        "properties": {
            "selfie_id": {"type": "string", "format": "uuid"},
            "encryption_key_id": {"type": "string"},
            "retention_expiry": {"type": "string", "format": "date-time"},
            "session_id": {"type": "string", "format": "uuid"},
        },
    }

    schemas["AttemptRecord"] = {
        "type": "object",
        "properties": {
            "attempt_id": {"type": "string", "format": "uuid"},
            "id_number_hash": {"type": "string", "example": "sha256:abc123..."},
            "masked_id": {
                "type": "string",
                "pattern": r"^\d{4}\*\*\*\*\*\*\d{4}$",
                "example": "8107******2089",
            },
            "status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
            "created_at": {"type": "string", "format": "date-time"},
        },
    }

    # 4. Enrich every path with security error responses and rate-limit headers
    paths = openapi_schema.get("paths", {})
    for _path, path_item in paths.items():
        for method, operation in path_item.items():
            if method == "parameters":
                continue

            # Add 401/403/409/429 response contracts
            responses = operation.setdefault("responses", {})
            for code, desc in [
                ("401", "Unauthorized — missing or invalid JWT"),
                ("403", "Forbidden — insufficient scope or geo-fence mismatch"),
                ("409", "Conflict — duplicate nonce or concurrent modification"),
                ("429", "Too Many Requests — rate limit exceeded"),
            ]:
                if code not in responses:
                    responses[code] = {
                        "description": desc,
                        "content": {
                            "application/json": {
                                "schema": {"$ref": "#/components/schemas/SecurityError"}
                            }
                        },
                    }

            # Add X-RateLimit-* headers to 2xx and 429 responses
            for resp_code in ["200", "201", "429"]:
                if resp_code in responses:
                    headers = responses[resp_code].setdefault("headers", {})
                    headers.update({
                        "X-RateLimit-Limit": {
                            "schema": {"type": "integer"},
                            "description": "Maximum requests allowed in the current window",
                        },
                        "X-RateLimit-Remaining": {
                            "schema": {"type": "integer"},
                            "description": "Requests remaining in the current window",
                        },
                        "X-RateLimit-Reset": {
                            "schema": {"type": "integer"},
                            "description": "Unix timestamp when the rate limit window resets",
                        },
                    })

            # Add POPIA classification to spec metadata
            operation.setdefault("x-popia-classification", "SPECIAL_PERSONAL_INFORMATION")

    # 5. Add global security requirements (all endpoints protected by default)
    openapi_schema["security"] = [
        {"bearerAuth": [], "correlationId": []},
    ]

    # 6. Explicitly exempt public endpoints
    public_paths = ["/healthz", "/readyz", "/auth/token"]
    for pub_path in public_paths:
        if pub_path in paths:
            for method in paths[pub_path]:
                if method == "parameters":
                    continue
                paths[pub_path][method]["security"] = []

    # 7. Mark Tier-1 endpoints with dual-auth requirement
    tier1_prefixes = ["/api/v1/sim-swap", "/api/v1/rica", "/api/v1/verifications"]
    for _path, path_item in paths.items():
        if any(_path.startswith(p) for p in tier1_prefixes):
            for method, operation in path_item.items():
                if method == "parameters":
                    continue
                # Override with dual-auth
                operation["security"] = [
                    {"bearerAuth": [], "apiKey": [], "correlationId": []},
                ]

    # 8. Add server info and compliance metadata
    openapi_schema.setdefault("info", {}).update({
        "x-data-classification": "RESTRICTED",
        "x-compliance-frameworks": ["POPIA", "GDPR", "ISO-27001"],
        "x-api-classification": "RESTRICTED",
    })

    servers = openapi_schema.setdefault("servers", [])
    if not any(s.get("url", "").endswith("azurecontainerapps.io") for s in servers):
        servers.append({
            "url": "https://team21-ca.livelycoast-bbf4360d.southafricanorth.azurecontainerapps.io",
            "description": "Sandbox",
            "x-mtls-required": False,
        })
        servers.append({
            "url": "https://api.facialbiometric.mtn.co.za",
            "description": "Production",
            "x-mtls-required": True,
        })

    app.openapi_schema = openapi_schema
    return openapi_schema


app.openapi = custom_openapi

# ── Include routers ──────────────────────────────────────────────────────────
#
# FIX: every call below was `X.router`. Backend/app/routers/__init__.py
# re-exports these already aliased to the router instance itself
# (`from .health import router as health`, `from .iccid import router as
# iccid`, etc - see the routers/__init__.py content you pasted earlier), so
# `auth`, `health`, `validation`, `verification`, `selfies`, `iccid`,
# `notifications`, `verifications`, and `sim_swap` imported here from
# `Backend.app.routers` ARE the APIRouter instances, not modules with a
# `.router` attribute. `.router` never worked for ANY of these - `health`
# just happened to be the one line that was already correct before, which is
# why fixing it to match the others broke it, and why `auth.router` failed
# next with the exact same error the moment health was fixed.

app.include_router(health)
app.include_router(auth)  # /auth/token issues test JWTs

app.include_router(validation)
app.include_router(verification)
app.include_router(selfies)
app.include_router(iccid)
app.include_router(notifications)

app.include_router(verifications)
app.include_router(sim_swap)

# ── Exception handlers ───────────────────────────────────────────────────────

@app.exception_handler(HTTPException)
async def http_exception_handler(request: Request, exc: HTTPException):
    """Return uniform SecurityError schema for all HTTP exceptions."""
    from Backend.app.schemas.security import SecurityError

    correlation_id = getattr(request.state, "correlation_id", "unknown")
    error = SecurityError(
        error="HTTPException",
        message=exc.detail,
        code=getattr(exc, "code", "UNKNOWN_ERROR"),
        correlation_id=correlation_id,
        timestamp=datetime.now(UTC).isoformat(),
        retry_after=getattr(exc, "retry_after", None),
    )
    return Response(
        content=error.model_dump_json(),
        status_code=exc.status_code,
        media_type="application/json",
        headers=getattr(exc, "headers", None) or {},
    )


@app.get("/", include_in_schema=False)
async def root():
    return {
        "service": "facial-biometric-api",
        "version": "1.0.0",
        "environment": ENV,
        "docs": "/docs" if docs_url else None,
    }
