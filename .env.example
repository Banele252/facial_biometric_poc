# Copy to .env for local development. Never commit the populated file.
# In deployed environments these arrive as Azure Container App secrets.

VERIFY_NOW_API_KEY=
VERIFY_BASE_URL=https://api.verifynow.example.com
# Casing is intentional — matches the key the application reads.
Idempotency_id_key=

# Optional
LOG_LEVEL=INFO
ENABLE_DOCS=true
PORT=8000
# Set when running the Vite dev server against a local API on another port.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Verification journey (HT2-11/12/14/15/24/25) ---
# Persistence for verification history and the notification inbox.
# Default is a local SQLite file. Point at the deployed Postgres to persist
# centrally (requires the optional 'psycopg' package):
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=sqlite:///data/verifications.db

# Selfie storage. Default writes to a local directory. Set an Azure Blob
# connection string to store in Blob (requires 'azure-storage-blob').
SELFIE_STORAGE_DIR=data/selfies
# AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=selfies

# Liveness provider. 'mock' is the dependency-free default; 'azure_face' is the
# CARB-intended provider (unavailable in the hackathon subscription).
#
# Note: VerifyNow also offers /passive-liveness, but its sandbox shares a
# 10-second per-IP cooldown with /facematch. Using both in one journey makes the
# second call fail, so liveness stays local and the single provider call is the
# Home Affairs face match.
LIVENESS_PROVIDER=mock
LIVENESS_MIN_SCORE=0.6

# --- VerifyNow call mode ---
# 'sandbox' returns mock responses and consumes NO credits. Anything other than
# the exact string 'production' is treated as sandbox, so a typo cannot spend
# credits. Only set 'production' deliberately, per environment.
VERIFY_MODE=sandbox
# Approval floor for the Home Affairs face match score (0-100). A provider
# "Approved" below this is downgraded to manual review rather than passed.
FACE_MATCH_MIN_SCORE=60

# --- System Chatbot agent (management-console/management-backend) ---
# Used by system_llm.py's OpenAI Agents SDK agent.
OPENAI_API_KEY=
# Set when running the management-frontend Vite dev server (port 5174)
# against this API locally.
MANAGEMENT_CORS_ALLOW_ORIGINS=http://localhost:5174
