# Copy to .env for local development. Never commit the populated file.
# In deployed environments these arrive as Azure Container App secrets.

VERIFY_NOW_API_KEY=
VERIFY_BASE_URL=https://api.verifynow.example.com

# Optional
LOG_LEVEL=INFO
ENABLE_DOCS=true
PORT=8000
# Set when running the Vite dev server against a local API on another port.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Verification journey (HT2-11/12/14/15/24/25) ---
# Persistence for verification history and the notification inbox.
# Default is a local SQLite file. Point at the deployed Postgres to persist
# centrally (requires the optional 'psycopg' package):
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=sqlite:///data/verifications.db

# Selfie storage. Default writes to a local directory. Set an Azure Blob
# connection string to store in Blob (requires 'azure-storage-blob').
SELFIE_STORAGE_DIR=data/selfies
# AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=selfies

# Liveness provider — is a live person present, rather than a photo of one?
#
#   mock        dependency-free heuristic. The default, and NOT a real check.
#   verifynow   VerifyNow /passive-liveness. A real check, and the one to use
#               where credits allow. Only viable with VERIFY_MODE=production:
#               the sandbox applies a ~10s per-IP cooldown across its routes,
#               so a journey calling liveness and the Home Affairs face match
#               would have its second call rejected. Costs a credit per capture.
#   azure_face  NOT usable. The Limited Access grant of 2026-08-01 covers
#               detect/verify only; liveness needs a separate application, and
#               Azure's liveness is a client-SDK session flow rather than a
#               server-side image call, so it would need front-end work too.
#
# This is the last mock in the pipeline: the document face match already runs
# on Azure Face, and the Home Affairs match on VerifyNow.
LIVENESS_PROVIDER=mock
LIVENESS_MIN_SCORE=0.6

# --- VerifyNow call mode ---
# 'sandbox' returns mock responses and consumes NO credits. Anything other than
# the exact string 'production' is treated as sandbox, so a typo cannot spend
# credits. Only set 'production' deliberately, per environment.
VERIFY_MODE=sandbox
# Approval floor for the Home Affairs face match score (0-100). A provider
# "Approved" below this is downgraded to manual review rather than passed.
FACE_MATCH_MIN_SCORE=60

# --- Document steps (OCR, live face vs document photo) ---
# 'mock' is the dependency-free default and keeps the whole journey runnable
# without Azure. 'azure' uses Document Intelligence for OCR and Azure AI Face
# for the document face match — both keys below are then required. Anything
# other than the exact string 'azure' is treated as the mock.
DOCUMENT_PROVIDER=mock
# AZURE_DOC_INTELLIGENCE_ENDPOINT=
# AZURE_DOC_INTELLIGENCE_KEY=
# Azure AI Face is a Limited Access service — the subscription needs an
# approved application before these return face IDs usable for verification.
# AZURE_FACE_API_ENDPOINT=
# AZURE_FACE_API_KEY=
# Match floor for the selfie-to-document-photo comparison (0-1).
DOCUMENT_FACE_MIN_CONFIDENCE=0.60

# Audit log for the fallback verification decision. Relative by default so the
# module imports anywhere; the container sets this to a directory the app user
# owns.
FALLBACK_AUDIT_LOG_PATH=data/logs/fallback_verification_audit.log

# --- Fraud pre-checks ---
# The diagram's first pre-check: "check against recent (7 days) rejected
# requests". A request matching a recent rejection on identity, MSISDN *or*
# device is referred to a human above the tolerance, and rejected at more than
# double it.
#
# Set the window to 0 to disable the check outright. Worth doing in a demo or
# test environment: repeating the same journey otherwise trips its own earlier
# failures for a week, and every attempt after the first lands in review.
RECENT_REJECTION_WINDOW_DAYS=7
MAX_RECENT_REJECTIONS=1

# --- Provider outages ---
# How many times a provider call is attempted before the journey gives up,
# matching "Home affairs integration not available after multiple tries".
PROVIDER_MAX_ATTEMPTS=3
# The process diagram rejects when the provider is still unreachable after
# those attempts. Set 'true' to instead approve on structural + liveness +
# document evidence and flag for manual review (HT2-15). Off by default: an
# outage should not become an approval unless someone chose that deliberately.
ALLOW_PROVIDER_FALLBACK=false
