{
  "expo": {
    "name": "Facial Biometric POC",
    "slug": "facial-biometric-poc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7EE"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mtn.facialbiometricpoc"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mtn.facialbiometricpoc"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Facial Biometric POC",
      "shortName": "Biometric POC",
      "display": "standalone",
      "themeColor": "#FFCB05",
      "backgroundColor": "#FFFDF9",
      "scope": "/",
      "startUrl": "/",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF7EE"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cf667e35-1fb7-478c-aa25-42b18edb6916"
      }
    }
  }
}
