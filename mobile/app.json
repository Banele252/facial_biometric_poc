{
  "expo": {
    "name": "Facial Biometric POC",
    "slug": "facial-biometric-poc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mtn.facialbiometricpoc",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.mtn.facialbiometricpoc",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Facial Biometric POC to access your camera to scan SIM barcodes and verify your identity."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF7EE"
        }
      ]
    ]
  }
}