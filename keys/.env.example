# Example values only — copy to .env (gitignored) and fill in real ones.
#
# WARNING: this file previously contained a live RSA private key inline, and
# the matching key is still committed at keys/private.pem. Both are in git
# history, so both must be treated as compromised: anyone with repo access can
# mint a valid token for any user and any scope. Generate a fresh pair before
# any deployed environment trusts this issuer:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#       -out jwt-private.pem
#   openssl rsa -pubout -in jwt-private.pem -out jwt-public.pem
#
# Keep newlines as literal \n when putting a PEM in a single-line env var;
# Backend/app/config.py normalises them back on read.

JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<your key here>\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<your key here>\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Sandbox API key. ZeroTrustMiddleware enforces the shape
# (sbx|prd)-ak-YYYY-MM-DD-<8 hex chars> before comparing the value.
SANDBOX_API_KEY=sbx-ak-YYYY-MM-DD-00000000
ADMIN_API_KEY=<generate a fresh one>

# Sandbox users for /auth/token, as JSON.
TEST_USERS_JSON='{"test_admin":{"password":"<set one>","allowed_scopes":["biometric:read","biometric:write","simswap:execute","rica:read","rica:write","admin:docs"],"default_geo_fence":"ZA-jnb"}}'

# Environment
ENV=development
VERIFY_MODE=sandbox

# Redis
REDIS_URL=redis://localhost:6379/0
